# Copy to .env (or let scripts/bootstrap.sh create it) and adjust for your host.
TZ=Europe/Amsterdam
# Address/port published on the host. Bind to 127.0.0.1 when a reverse proxy
# runs on the same host; use the Tailscale/LAN address when a proxy on another
# host must reach it.
BIND_IP=0.0.0.0
HOST_PORT=8080
# Serial device of the TEF6686 tuner.
TUNER_DEVICE=/dev/ttyACM0
# Group IDs on the host: `getent group audio` / `getent group dialout`.
AUDIO_GID=29
DIALOUT_GID=20
# Extra application logging.
FM_DX_DEBUG=false
FM_DX_FFMPEG_DEBUG=false
# Apply a local site overlay from site/overlay during the build (local images).
APPLY_SITE_OVERLAY=false
IMAGE_TAG=local
