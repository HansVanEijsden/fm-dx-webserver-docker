+    // MM_ORT_QUIET: the ONNX WASM runtime prints harmless "Removing unused
+    // initializer" lines during model creation; they are warnings, not errors.
+    // Filter only those, so the Safari/Chrome console stays readable.
+    (function quietOrtWarnings() {
+        if (window.__mmOrtQuiet) return;
+        window.__mmOrtQuiet = true;
+        const originalError = console.error.bind(console);
+        console.error = (...args) => {
+            try {
+                const text = args.map((arg) => String(arg)).join(' ');
+                if (text.includes('CleanUnusedInitializers') || text.includes('[W:onnxruntime')) return;
+            } catch (_) { /* fall through */ }
+            originalError(...args);
+        };
+    })();
